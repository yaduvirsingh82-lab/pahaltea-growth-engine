# Non-secret local configuration only. Do not add credentials to this file.
APP_ENV=development
WRITE_ACTIONS_ENABLED=false

# Host port for the local Docker Postgres. Defaults to 5433 because 5432 is
# frequently already bound by another local database.
PAHALTEA_DB_PORT=5433
DATABASE_URL=postgresql://pahaltea:local-development-only@localhost:5433/pahaltea_growth_engine

# --- Meta / Instagram publishing (secrets: keep in a real .env, never commit) ---
# META_LOGIN_KIND=facebook            # facebook (default, also carries Ads later) | instagram
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=                  # long-lived token
# META_IG_USER_ID=                    # Instagram professional account id
# META_PAGE_ID=                       # alternative: discover the IG id from the linked Page

# --- Cloudflare R2 media hosting ---
# Instagram fetches the image from a public URL, so the bucket must be publicly readable.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=                 # e.g. https://media.pahaltea.com
