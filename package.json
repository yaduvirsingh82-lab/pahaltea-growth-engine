{
  "name": "pahaltea-growth-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Approval-first growth operations platform for Pahal Tea.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --experimental-strip-types packages/db/bin/migrate.ts",
    "db:seed": "node --experimental-strip-types packages/db/bin/seed.ts",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate && npm run db:seed",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --experimental-strip-types --test packages/domain/test/*.test.ts packages/db/test/*.test.ts",
    "validate": "npm run check && npm test"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
